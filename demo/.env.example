# agentic-dni demo — variables de entorno (copiar a .env y completar; .env NO se commitea)
# Todo es devnet / datos de prueba. NUNCA pegar seeds ni fondos reales.
#
# Los valores devnet de abajo son los de la demo desplegada (02/10/2026) —
# direcciones públicas, no secretos. Para re-correr el setup propio:
# `bash scripts/setup_devnet.sh` genera keypairs/direcciones nuevas.

# Cluster
SOLANA_RPC_URL=https://api.devnet.solana.com

# Programa gate (deploy S5 — anchor deploy → devnet)
AGENTIC_GATE_PROGRAM_ID=D8pcKtezTzhVA6fw2SLpyFP5wY1DfUiPJCVmeqqX1xG2

# SAS real en devnet (scripts/setup_sas.ts — credential + schema del mock issuer)
SAS_CREDENTIAL=JDe4sL4r73pQ3ovgkk95wNTo4SaS3U48R9PryQeZ3HRC
SAS_SCHEMA=6bz7y1xCr8k6PzAGP1P9cwNp9Qp8RPbDjzDgod7M7ohK

# Mint USDC de prueba, 6 decimales (scripts/setup_tokens.ts)
USDC_MINT=gmfqCXG6Jj5s3hS4uALJBHbN14ai8J8XWsp459vrpTk

# Keypairs de actores (paths relativos a demo/ — los archivos viven en keys/, gitignored)
OWNER_KEYPAIR=keys/owner.json
AGENT_A_KEYPAIR=keys/agent-a.json
AGENT_B_KEYPAIR=keys/agent-b.json
ISSUER_KEYPAIR=keys/issuer.json
PAYER_KEYPAIR=~/.config/solana/id.json

# Pubkeys de actores de la demo desplegada (salida de setup_devnet.sh)
OWNER_WALLET=F3ij1MAL19AnRfBSjgodtMnqDREXSdw4QhFafF48KjAF
AGENT_A_WALLET=EVtpj89o2qTvMT3CkGgr5iYdHbDUnFhTXtM6YcPrGGv
AGENT_B_WALLET=BXq73ERaMHUEsXbVtycQFqUodn5qVocFtA83ZHkusgJq
ISSUER_WALLET=AK5QDUmPWRRjZfGmPi4ZEADYwbThE8RrDtQKJdv4gabw
SERVICE_X_WALLET=9TPfKcdex7EobDJd9qgrTV78NPjxoe1SKcbKv6j8Pffe
SERVICE_Y_WALLET=ymz65JASu8bUyFxXqyeFSyGUVbWvPn5GXZETv3Gok6G
