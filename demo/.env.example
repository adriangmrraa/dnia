# agentic-dni demo — variables de entorno (copiar a .env y completar; .env NO se commitea)
# Todo es devnet / datos de prueba. NUNCA pegar seeds ni fondos reales.

# Cluster
SOLANA_RPC_URL=https://api.devnet.solana.com

# Programa gate (se completa tras deploy — S5)
AGENTIC_GATE_PROGRAM_ID=D8pcKtezTzhVA6fw2SLpyFP5wY1DfUiPJCVmeqqX1xG2

# SAS real en devnet (se completan tras scripts/setup_sas.ts — S5)
SAS_CREDENTIAL=
SAS_SCHEMA=

# Mint USDC de prueba, 6 decimales (se completa tras setup_devnet.sh — S5)
USDC_MINT=

# Keypairs de actores (paths relativos a demo/ — los archivos viven en keys/, gitignored)
OWNER_KEYPAIR=keys/owner.json
AGENT_A_KEYPAIR=keys/agent-a.json
AGENT_B_KEYPAIR=keys/agent-b.json
ISSUER_KEYPAIR=keys/issuer.json
PAYER_KEYPAIR=~/.config/solana/id.json

# Wallets de servicios (pubkeys — outputs de setup_devnet.sh)
SERVICE_X_WALLET=
SERVICE_Y_WALLET=

# Servicios HTTP (S6)
ISSUER_PORT=3401
SERVICE_X_PORT=3402
SERVICE_Y_PORT=3403
SERVICE_X_URL=http://localhost:3402
SERVICE_Y_URL=http://localhost:3403
SERVICE_PRICE=500000
