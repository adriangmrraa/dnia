# surfpool@1.6 declara peerOptional @solana/kit@^8, pero el repo pinea kit@5
# porque sas-lib@1.0.10 emite ixs en formato kit v5 (verificado S2–S4).
# peerDeps estrictos hacen fallar `npm install` al agregar workspaces;
# legacy-peer-deps conserva kit@5 y surfpool funciona igual (20/20 tests).
legacy-peer-deps=true
